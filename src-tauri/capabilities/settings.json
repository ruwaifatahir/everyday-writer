{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings window: reads and saves the provider, model and Custom base URL, saves or clears keys, lists the saved provider's models, changes the shortcut and start-with-Windows, and manages instruction sets. It can ask whether a key is saved but can never read one.",
  "windows": ["settings"],
  "permissions": [
    "allow-get-settings",
    "allow-save-settings",
    "allow-is-key-saved",
    "allow-save-api-key",
    "allow-clear-api-key",
    "allow-list-models",
    "allow-set-shortcut",
    "allow-is-shortcut-working",
    "allow-set-start-with-windows",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-instruction-sets",
    "allow-add-instruction-set",
    "allow-edit-instruction-set",
    "allow-delete-instruction-set",
    "allow-set-active-instruction-set",
    "allow-restore-starter-templates"
  ]
}
